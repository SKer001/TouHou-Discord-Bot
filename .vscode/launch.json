    "version": "0.2.0",
    "configurations": [
			{
				"name": "Python: Current Dir (external)",
				"type": "debugpy",
				"request": "launch",
				"cwd": "${fileDirname}",
				"program": "${file}",
				"console": "externalTerminal",
				"env": {
					"PYTHONPATH": "Code file"
				},
			},
			{
				"name": "Python: Current Dir (internal)",
				"type": "debugpy",
				"request": "launch",
				"cwd": "${fileDirname}",
				"program": "${file}",
				"console": "integratedTerminal",
				"env": {
					"PYTHONPATH": "Code file"
				},
			},
			{
				"name": "Python: Current File (Integrated Terminal)",
				"type": "debugpy",
				"request": "launch",
				"program": "${file}",
				"console": "integratedTerminal",
			}
    ]
}