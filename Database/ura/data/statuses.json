{
    "_說明": "🌀 裏世界的狀態效果 (docs/ura.md「狀態效果」)。加新狀態只要在這裡加一筆，不用改程式。",
    "_欄位": {
        "duration": "rounds 回合 / count 次數 / battle 這場戰鬥 / steps 步數 (每進一關 -1) / run 整局",
        "default": "沒指定時的持續量 (回合數 / 次數 / 步數)",
        "max_stacks": "最多幾層 (1 = 不能疊，再施加只刷新時間)",
        "group": "倍率屬於哪一類 (item 道具 / relic 法具 / spell 符卡 / env 環境)：同一類相加，不同類相乘",
        "mods": "數值修正；值可以是數字或 \"value\" / \"-value\" (施加時給的數字，例如 0.25)",
        "flags": "skip_turn 跳過回合、wake_on_hit 被打就醒、taunt 嘲諷、invuln 無敵、boss_half 對 BOSS 回合數減半、boss_immune 對 BOSS 無效、scout 斥候效果、cleanse 可以被淨化、battle_only 戰鬥結束就消失",
        "on": "觸發時機 round_start / round_end / on_hit / on_down / battle_start / floor_enter ➔ 動作清單"
    },
    "freeze": {"name": "凍住", "emoji": "❄️", "good": false, "duration": "rounds", "default": 1, "max_stacks": 1,
               "flags": ["skip_turn", "boss_half", "cleanse"], "desc": "跳過回合 (被打不會醒)"},
    "sleep": {"name": "睡著", "emoji": "💤", "good": false, "duration": "rounds", "default": 1, "max_stacks": 1,
              "flags": ["skip_turn", "wake_on_hit", "boss_half", "cleanse"], "desc": "跳過回合，被打就醒"},
    "seal": {"name": "封印", "emoji": "🔒", "good": false, "duration": "rounds", "default": 1, "max_stacks": 1,
             "flags": ["skip_turn", "boss_immune", "cleanse"], "desc": "跳過回合 (BOSS 無效)"},
    "taunt": {"name": "嘲諷", "emoji": "📣", "good": true, "duration": "rounds", "default": 2, "max_stacks": 1,
              "flags": ["taunt"], "desc": "敵人全部打這位"},
    "counter": {"name": "反擊架式", "emoji": "🌀", "good": true, "duration": "rounds", "default": 2, "max_stacks": 1,
                "on": {"on_hit": [{"do": "counter", "mult": "value"}]}, "desc": "被打時反擊 (自己 ATK × 倍率)"},
    "invuln": {"name": "無敵", "emoji": "🌟", "good": true, "duration": "rounds", "default": 1, "max_stacks": 1,
               "flags": ["invuln"], "desc": "不會受到傷害"},
    "shield": {"name": "護盾", "emoji": "🔰", "good": true, "duration": "count", "default": 1, "max_stacks": 1,
               "mods": {"block_pct": "value"}, "flags": ["battle_only"], "desc": "擋下一次傷害的一部分"},
    "buff_atk": {"name": "強化・ATK", "emoji": "⬆️", "good": true, "duration": "rounds", "default": 3, "max_stacks": 1,
                 "group": "spell", "mods": {"atk_pct": "value"}, "desc": "ATK 提升"},
    "buff_def": {"name": "強化・DEF", "emoji": "🛡️", "good": true, "duration": "rounds", "default": 3, "max_stacks": 1,
                 "group": "spell", "mods": {"def_pct": "value"}, "desc": "DEF 提升"},
    "doll_legion": {"name": "人形助陣", "emoji": "🎎", "good": true, "duration": "rounds", "default": 3, "max_stacks": 1,
                    "group": "spell", "mods": {"atk_pct": "value"},
                    "on": {"round_end": [{"do": "auto_attack", "mult": 0.3, "use": "source_atk"}]},
                    "desc": "ATK 提升，人形每回合幫忙打一隻"},
    "mima_power": {"name": "魅魔之力", "emoji": "😈", "good": true, "duration": "rounds", "default": 2, "max_stacks": 3,
                   "group": "spell", "mods": {"atk_pct": 0.1}, "desc": "ATK +10% (最多 3 層)"},
    "debuff_atk": {"name": "弱化・ATK", "emoji": "⬇️", "good": false, "duration": "rounds", "default": 3, "max_stacks": 1,
                   "group": "spell", "mods": {"atk_pct": "-value"}, "flags": ["cleanse"], "desc": "ATK 下降"},
    "debuff_def": {"name": "弱化・DEF", "emoji": "💔", "good": false, "duration": "rounds", "default": 3, "max_stacks": 1,
                   "group": "spell", "mods": {"def_pct": "-value"}, "flags": ["cleanse"], "desc": "DEF 下降"},
    "evil_eye": {"name": "邪眼", "emoji": "👁️", "good": false, "duration": "rounds", "default": 3, "max_stacks": 1,
