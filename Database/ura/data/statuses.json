    "compass": {"name": "寶箱羅盤", "emoji": "🧭", "good": true, "duration": "count", "default": 1, "max_stacks": 1,
                "flags": ["force_chest"], "desc": "下一關一定有一扇寶箱門"},
    "horn": {"name": "挑戰號角", "emoji": "📯", "good": true, "duration": "count", "default": 1, "max_stacks": 1,
