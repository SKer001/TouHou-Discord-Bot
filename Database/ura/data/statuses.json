    "relic_guard": {"name": "鐵壁加護", "emoji": "✨", "good": true, "duration": "run", "default": 1, "max_stacks": 1,
                    "mods": {"dmg_taken_pct": "-value"}, "desc": "受到傷害降低 (法具)"},
    "relic_life": {"name": "生命加護", "emoji": "✨", "good": true, "duration": "run", "default": 1, "max_stacks": 1,
