    "madness": {"name": "狂氣", "emoji": "🌙", "good": false, "duration": "rounds", "default": 2, "max_stacks": 1,
                "group": "spell", "mods": {"atk_pct": -0.15}, "flags": ["cleanse"], "desc": "ATK −15%"},
    "burn": {"name": "燒傷", "emoji": "🔥", "good": false, "duration": "rounds", "default": 3, "max_stacks": 1,
             "flags": ["cleanse"], "on": {"round_end": [{"do": "dot_max_hp_pct", "value": 0.05}]},
             "desc": "回合結束扣 5% 最大 HP"},
    "death_butterfly": {"name": "死蝶", "emoji": "🦋", "good": false, "duration": "rounds", "default": 2, "max_stacks": 1,
                        "flags": ["cleanse"], "on": {"round_end": [{"do": "dot_max_hp_pct", "value": 0.05}]},
                        "desc": "回合結束扣 5% 最大 HP"},
    "blaze": {"name": "浴火", "emoji": "♨️", "good": true, "duration": "rounds", "default": 3, "max_stacks": 1,
              "on": {"on_hit": [{"do": "reflect_pct", "value": 0.05}]}, "desc": "被打時反彈 5% 傷害"},
    "breach": {"name": "破綻", "emoji": "💢", "good": false, "duration": "battle", "default": 1, "max_stacks": 1,
               "mods": {"def_final_mult": 0.9, "incoming_atk_mult": 1.1}, "desc": "我方攻擊 × 1.1、DEF × 0.9"},
    "enrage": {"name": "狂暴", "emoji": "😡", "good": false, "duration": "battle", "default": 1, "max_stacks": 1,
               "desc": "超過 10 回合，每回合 ATK +10%"},
    "possessed": {"name": "附身", "emoji": "👻", "good": false, "duration": "steps", "default": 3, "max_stacks": 1,
                  "group": "spell", "mods": {"atk_pct": -0.15}, "flags": ["cleanse"], "desc": "ATK −15%"},
    "trial_fire": {"name": "試煉之火", "emoji": "🔥", "good": true, "duration": "steps", "default": 9, "max_stacks": 1,
