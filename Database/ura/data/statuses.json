    "notes": {"name": "古老的筆記", "emoji": "📖", "good": true, "duration": "steps", "default": 1, "max_stacks": 1,
              "flags": ["scout"], "desc": "下一關的門全部看穿"},
    "amulet": {"name": "避邪護符", "emoji": "🧿", "good": true, "duration": "count", "default": 1, "max_stacks": 1,
